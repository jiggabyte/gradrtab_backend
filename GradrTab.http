@GradrTab_HostAddress = http://localhost:5120
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..zbURci_89wNDm9TcJaQhf2XzWegGo_OTIszQLKvKAC0
@documentId = d2ec6cc7-a60e-4650-8c60-c2f95df25571
@resetToken = 4gJOOXHbrNkejPsksKs4-oRgfVmiix36XhZ65zJbsr4
@rubricId = 0e097997-a6aa-4dbd-b8ba-e70b633c821a
@submissionId = 4f68572e-a30f-46aa-97af-4ba18ce6a0e1
GET {{GradrTab_HostAddress}}/api/v1/health
Accept: application/json

###

# Register a user
POST {{GradrTab_HostAddress}}/api/v1/register
Content-Type: application/json

{
  "firstName": "Jigga",
  "lastName": "Byte",
  "email": "jigga.e10@gmail.com",
  "password": "Passw0rd!"
}

###

# Log in, copy the token from the response into @token above
POST {{GradrTab_HostAddress}}/api/v1/login
Content-Type: application/json

{
  "email": "jigga.e10@gmail.com",
  "password": "Passw0rd!"
}

###

# Get user details
GET {{GradrTab_HostAddress}}/api/v1/me
Content-Type: application/json
Authorization: Bearer {{token}}

###

# Ask for a password reset link. The answer is always 202, whether or not the
# address has an account. The link arrives by email, copy its ?token= value
# into @resetToken below.
POST {{GradrTab_HostAddress}}/api/v1/forgot-password
Content-Type: application/json

{
  "email": "jigga.e10@gmail.com"
}

###

# Set the new password with the token from the emailed link
POST {{GradrTab_HostAddress}}/api/v1/reset-password
Content-Type: application/json

{
  "token": "{{resetToken}}",
  "newPassword": "Str0ngerPassw0rd!",
  "confirmPassword": "Str0ngerPassw0rd!"
}

###

# Log in again with the new password
POST {{GradrTab_HostAddress}}/api/v1/login
Content-Type: application/json

{
  "email": "jigga.e10@gmail.com",
  "password": "Str0ngerPassw0rd!"
}

###

# Upload documents as multipart/form-data.
# Repeat the field for more files, the field name can be anything.
POST {{GradrTab_HostAddress}}/api/v1/documents
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=----GradrTabBoundary

------GradrTabBoundary
Content-Disposition: form-data; name="files"; filename="economics.docx"
Content-Type: text/docx

< ./samples/economics.docx
------GradrTabBoundary--

###

# Everything that was read out of one document, first 200 entries
GET {{GradrTab_HostAddress}}/api/v1/documents/{{documentId}}/detail
Authorization: Bearer {{token}}

###

# Paged entries of one document
GET {{GradrTab_HostAddress}}/api/v1/documents/{{documentId}}/entries?page=1&pageSize=50
Authorization: Bearer {{token}}

###

# List documents, optionally filtered
GET {{GradrTab_HostAddress}}/api/v1/documents?page=1&pageSize=20&type=Pdf&status=Completed
Authorization: Bearer {{token}}

###

# Search inside the stored file names and the extracted text
GET {{GradrTab_HostAddress}}/api/v1/documents?search=grading
Authorization: Bearer {{token}}

###

# Download the original upload
GET {{GradrTab_HostAddress}}/api/v1/documents/{{documentId}}/content
Authorization: Bearer {{token}}

###

# Read the stored copy again after an extractor changed
POST {{GradrTab_HostAddress}}/api/v1/documents/{{documentId}}/reprocess
Authorization: Bearer {{token}}

###

# Check how much of a document's extracted text reads as AI-generated.
# The body is optional, it only carries overrides.
POST {{GradrTab_HostAddress}}/api/v1/documents/{{documentId}}/ai-detection
Authorization: Bearer {{token}}
Content-Type: application/json

{}

###

# Delete a document, its entries and the stored file
DELETE {{GradrTab_HostAddress}}/api/v1/documents/{{documentId}}
Authorization: Bearer {{token}}

###

# ---- Rubrics ----

# Create a rubric. The server adds the id, the owner and the timestamps.
POST {{GradrTab_HostAddress}}/api/v1/rubrics
Authorization: Bearer {{token}}
Content-Type: application/json

< ./samples/rubric_request.json

###

# Every rubric of the signed in user, newest first
GET {{GradrTab_HostAddress}}/api/v1/rubrics?page=1&pageSize=20
Authorization: Bearer {{token}}

###

# One rubric, including its content
GET {{GradrTab_HostAddress}}/api/v1/rubrics/{{rubricId}}
Authorization: Bearer {{token}}

###

# Replace the course and the content of a rubric
PUT {{GradrTab_HostAddress}}/api/v1/rubrics/{{rubricId}}
Authorization: Bearer {{token}}
Content-Type: application/json

< ./samples/rubric_request.json

###

# Delete a rubric
DELETE {{GradrTab_HostAddress}}/api/v1/rubrics/{{rubricId}}
Authorization: Bearer {{token}}

###

# ---- Submissions ----

# File a submission against a rubric, it starts out as NotStarted
POST {{GradrTab_HostAddress}}/api/v1/submissions
Authorization: Bearer {{token}}
Content-Type: application/json

< ./samples/submission_request.json

###

# Every submission of the signed in user, newest first
GET {{GradrTab_HostAddress}}/api/v1/submissions?page=1&pageSize=20
Authorization: Bearer {{token}}

###

# Only the submissions filed against one rubric
GET {{GradrTab_HostAddress}}/api/v1/submissions?rubricId={{rubricId}}&page=1&pageSize=20
Authorization: Bearer {{token}}

###

# One submission, including its evaluation
GET {{GradrTab_HostAddress}}/api/v1/submissions/{{submissionId}}
Authorization: Bearer {{token}}

###

# Replace the student, the rubric, the document and the evaluation
PUT {{GradrTab_HostAddress}}/api/v1/submissions/{{submissionId}}
Authorization: Bearer {{token}}
Content-Type: application/json

< ./samples/submission_request.json

###

# Grade a submission. The assessment of its uploaded document is graded
# against the rubric it was filed with and the evaluation is stored on the
# submission. The body is optional, it only carries overrides:
# { "model": "openai/gpt-4o-mini", "instructions": "weigh the sources heavily" }
POST {{GradrTab_HostAddress}}/api/v1/submissions/{{submissionId}}/grade
Authorization: Bearer {{token}}
Content-Type: application/json

{}

###

# Check how much of the assessment behind a submission reads as AI-generated.
# The body is optional, it only carries overrides:
# { "model": "openai/gpt-4o-mini", "instructions": "non-native writers" }
POST {{GradrTab_HostAddress}}/api/v1/submissions/{{submissionId}}/ai-detection
Authorization: Bearer {{token}}
Content-Type: application/json

{}

###

# Mail the stored grading result of a submission to a grader. The mail carries
# the submission details, the rubric details and the evaluation, so grade first.
POST {{GradrTab_HostAddress}}/api/v1/submissions/{{submissionId}}/email-grading-result
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "graderEmail": "jigga.e10@gmail.com"
}

###

# Delete a submission
DELETE {{GradrTab_HostAddress}}/api/v1/submissions/{{submissionId}}
Authorization: Bearer {{token}}

###

# ---- AI (OpenRouter) ----

# Is a provider key configured? Lets a frontend hide the AI features
GET {{GradrTab_HostAddress}}/api/v1/ai/status
Authorization: Bearer {{token}}

###

# The shortest possible question
POST {{GradrTab_HostAddress}}/api/v1/ai/chat
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "prompt": "What is the meaning of life?"
}

###

# A system prompt, a model override and a token budget
POST {{GradrTab_HostAddress}}/api/v1/ai/chat
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "systemPrompt": "You grade student essays. Answer with JSON only.",
  "prompt": "Grade this thesis: 'Social media shortens attention spans.'",
  "temperature": 0.2,
  "maxTokens": 500
}

###

# A whole conversation, the messages are sent to the provider as they are
POST {{GradrTab_HostAddress}}/api/v1/ai/chat
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "messages": [
    { "role": "user", "content": "Name three rubric criteria for an essay." }
  ]
}

###

# Check raw assessment text for AI usage without a stored document.
# Returns the aiPercentage, verdict, confidence and signals.
POST {{GradrTab_HostAddress}}/api/v1/ai/detect
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "text": "Paste at least 200 characters of the assessment here..."
}

###

