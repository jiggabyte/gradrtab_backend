# ---- GradrTab local dev template ----
# Copy to `.env` and fill in. Never commit `.env`.
# Real environment variables always override .env values.

# Kestrel port (Render injects this automatically; set locally to match launchSettings)
PORT=5120

# Option A: single URL (same format Render gives you)
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/gradrtab_db?sslmode=prefer

# Option B: discrete parts (used only when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gradrtab_db
DB_USER=root
DB_PASSWORD=
# Require in production (Render), prefer/disable locally
DB_SSLMODE=prefer

# JWT (maps to JwtSettings__Secret via ASP.NET env binding; also read as JWT_SECRET fallback)
JwtSettings__Secret=YourSuperSecretAndVeryLongKeyThatIsAtLeast32CharactersLong!
JwtSettings__Issuer=GradrTab
JwtSettings__Audience=GradrTabUsers
JwtSettings__DurationInMinutes=60

# ASP.NET environment
ASPNETCORE_ENVIRONMENT=Development

# ---- AI (OpenRouter chat completions) ----
# The key is never read from appsettings, set it here and it wins.
# Without it the app still starts, GET /api/v1/ai/status reports
# isConfigured = false and POST /api/v1/ai/chat answers 503.
OPENROUTER_API_KEY=

# Optional overrides, the defaults come from the "Ai" section of appsettings.json
# Ai__BaseUrl=https://openrouter.ai/api/v1/chat/completions
# Ai__Model=~openai/gpt-sol-latest
# Ai__TimeoutSeconds=120
# Ai__DefaultMaxTokens=2000

# Optional, only used for the openrouter.ai leaderboard
# Ai__SiteUrl=https://your-site.example
# Ai__SiteName=GradrTab

# ---- Password reset (SMTP) ----
# Without these the app still starts, POST /api/v1/forgot-password answers 503
# and says what is missing. SMTP_* are aliases of the Smtp__* config keys.
# Port 1025 + no TLS is what a local MailHog / Mailpit relay expects.
SMTP_HOST=smtp.mail.yahoo.com
SMTP_PORT=465
SMTP_ENABLE_SSL=true
SMTP_USERNAME=jizzle4real@yahoo.fr
SMTP_PASSWORD=
SMTP_FROM_EMAIL=jizzle4real@yahoo.fr
SMTP_FROM_NAME=GradrTab

# Where the emailed link points, this is your frontend page, not an API route
PasswordReset__FrontendBaseUrl=http://localhost:5173
# PasswordReset__TokenLifetimeMinutes=30
# PasswordReset__MaxRequestsPerHour=5
# PasswordReset__MinimumPasswordLength=8
