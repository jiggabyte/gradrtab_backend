# ---- GradrTab local dev template ----
# Copy to `.env` and fill in. Never commit `.env`.
# Real environment variables always override .env values.

# Kestrel port (Render injects this automatically; set locally to match launchSettings)
PORT=5120

# Option A: single URL (same format Render gives you)
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/gradrtab_db?sslmode=prefer

# Option B: discrete parts (used only when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gradrtab_db
DB_USER=root
DB_PASSWORD=wulfclan
# Require in production (Render), prefer/disable locally
DB_SSLMODE=prefer

# JWT (maps to JwtSettings__Secret via ASP.NET env binding; also read as JWT_SECRET fallback)
JwtSettings__Secret=YourSuperSecretAndVeryLongKeyThatIsAtLeast32CharactersLong!
JwtSettings__Issuer=GradrTab
JwtSettings__Audience=GradrTabUsers
JwtSettings__DurationInMinutes=60

# ASP.NET environment
ASPNETCORE_ENVIRONMENT=Development
